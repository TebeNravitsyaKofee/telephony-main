{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build Debug",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "-O0",
                "-DDEBUG",
                "${workspaceFolder}/*.cpp",
                "${workspaceFolder}/Parsers/*.cpp",
                "${workspaceFolder}/Modules/*.cpp",
                "-o",
                "${workspaceFolder}/app_debug",
                "-lssl",
                "-lcrypto",
                "-lodbc"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Debug build with -g and -DDEBUG"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++ build Release",
            "command": "/usr/bin/g++",
            "args": [
                "-fdiagnostics-color=always",
                "-O3",
                "${workspaceFolder}/*.cpp",
                "-o",
                "${workspaceFolder}/app_release",
                "-lssl",
                "-lcrypto"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build"
            },
            "detail": "Release build with optimizations"
        }
    ],
    "version": "2.0.0"
}